{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solwation/lunden-3d-apartment/shared/schema/measurements.schema.json",
  "title": "Lunden measurement data for Unreal (#2245)",
  "description": "measurements.json written by tools/unreal-engine/export-world.mjs from src/config.js, data/plan.json, data/elevation.json and the built web world: the numbers Unreal logic reads instead of copying them (levels, spawn, player, stair, doors with hinge and swing, windows, lights, terrain grid reference, site, material keys, the position-test fixture). Points carry both web metres (`web`, x east / y up / z south) and Unreal centimetres (`unreal`, X = 100x, Y = 100z, Z = 100y; tools/unreal-engine/coordinates.mjs).",
  "type": "object",
  "required": ["formatVersion", "kind", "sourceCommit", "units", "axes", "zones", "plan", "spawn", "stair", "doors", "windows", "lights", "terrain", "site", "materials", "fixture"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "lunden-measurements" },
    "sourceCommit": { "type": ["string", "null"] },
    "units": { "type": "object" },
    "axes": { "type": "object", "required": ["web", "unreal", "yaw"] },
    "zones": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "what", "status", "box"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "what": { "type": "string" },
          "status": { "enum": ["exported", "planned"] },
          "box": { "type": ["object", "null"], "description": "plan metres {x0, x1, z0, z1, y0, y1}: a node belongs to the first zone that holds the centre of its world bounding box (and accepts its builder, `from`)" },
          "from": { "type": "array", "items": { "type": "string" }, "description": "#2279: the web builders this zone takes objects from (exterior, visit, core-l, portik, surroundings, surroundings-site, garage, core-abc); absent = any part of buildWorld (the l1007 zones)" },
          "split": { "type": "boolean", "description": "#2279: merged meshes are cut at this zone's box sides and each piece goes to the zone holding its centroid" },
          "skip": { "type": "string", "description": "#2280: what this zone leaves to other issues (a name pattern of the object or its parents, or a leaf material)" },
          "only": { "type": "string", "description": "#2281: the only objects this zone takes (a name pattern of the object or its parents, or a leaf material)" }
        }
      }
    },
    "plan": {
      "type": "object", "required": ["size", "source", "unitTop", "levels", "vertical", "doorHeight"],
      "properties": {
        "size": { "type": "object", "required": ["x", "z"] },
        "levels": {
          "type": "array", "minItems": 2,
          "items": { "type": "object", "required": ["name", "storey", "floor", "ceiling", "top", "unreal"],
            "properties": { "name": { "type": "string" }, "storey": { "type": "integer" }, "floor": { "type": "number" }, "ceiling": { "type": "number", "description": "clear room height RH above `floor`" }, "top": { "type": "number", "description": "the next level's finished floor" }, "unreal": { "type": "object", "required": ["floorZ", "ceilingZ", "topZ"] } } }
        },
        "doorHeight": { "type": "number" }
      }
    },
    "spawn": {
      "type": "object", "required": ["start", "player"],
      "properties": {
        "start": { "type": "object", "required": ["web", "unreal", "feetY", "eyeY", "yawDeg", "pitchDeg", "unrealEye", "unrealYaw", "unrealPitch", "source"] },
        "player": { "type": "object", "required": ["eye", "radius", "walk", "run", "source"] },
        "fall": { "type": "object", "description": "#2284: the web fall-damage rule (src/config.js FALL, COMBAT.lives) with sample results of src/falldamage.js: drops in metres, damage in lives (null = not reported)", "required": ["hurt", "fatal", "free", "lives", "samples", "source"] },
        "surface": { "type": "object", "description": "#2300: the footstep surface under the feet, src/stepsurface.js stepInfo sampled by tools/unreal-engine/export-player.js: a ground raster and height-dependent boxes (Unreal cm), the stair levels, named control points and random samples with the web's answers", "required": ["surfaces", "wheres", "grid", "boxes", "levels", "floorTol", "control", "samples", "check", "source"] },
        "rest": { "type": "object", "description": "#2300: rest spots of the exported furniture (src/rest.js restTarget) with eye, aim, yaw and start view in Unreal terms, and the REST limits (degrees, cm)", "required": ["move", "reach", "limits", "spots", "source"] },
        "respawn": { "type": "object", "description": "#2300: the wake points a death may use (src/respawn.js grid candidates the web accepts), the wake yaw and the src/fall.js blackout timings", "required": ["yaw", "points", "blackout", "source"] }
      }
    },
    "stair": { "type": "object", "required": ["foot", "rise", "riser", "treads", "hole", "source"], "properties": { "foot": { "$ref": "#/$defs/point" },
      "lightBounds": { "description": "Stair shaft and ground-floor approach passage, metres [xMin,zMin,yMin,xMax,zMax,yMax].", "type": "array", "items": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } } } } },
    "doors": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "zone", "kind", "level", "source", "name"],
        "properties": {
          "id": { "type": ["string", "null"], "description": "node id in the zone GLB (null: the door is in a zone not exported); with `parts` (#2314) the interactable's id, and the leaf is those nodes" },
          "kind": { "enum": ["swing", "sliding", "wardrobe", "overhead"], "description": "src/doors.js: swing = SwingDoor (hinge + angles), sliding / wardrobe = sliding panels (centre + size); #2314: overhead = the garage door (pivot, axis, angleDeg, checkClosed/checkOpen like a window sash)" },
          "parts": { "type": "array", "items": { "type": "string" }, "description": "#2314: the GLB nodes of a leaf exported as several nodes (Hus L's stairwell doors, the entrances of Hus A/B/C, the garage door's sections)" },
          "wireId": { "type": "string", "pattern": "^[wLABCgq](0|[1-9][0-9]{0,2})$", "description": "Optional public room id from the matching DoorSync registration (#2293)" },
          "leafType": { "enum": ["flat", "steel", "park", "cage"], "description": "#2328: moving leaf from CoreHouse or Garage.cageDoors" },
          "checkClosed": { "$ref": "#/$defs/point" },
          "checkOpen": { "$ref": "#/$defs/point" },
          "control": { "type": "object", "required": ["autoSeconds", "opening", "buttons"],
            "properties": {
              "autoSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "opening": { "type": "object", "required": ["x", "radius", "xMargin", "z0", "z1", "top"], "additionalProperties": { "type": "number" },
                "description": "Web metres. The visitor's feet must be below top, strictly between z0 and z1, and within radius + xMargin of x." },
              "buttons": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "required": ["id", "part", "position"],
                "properties": { "id": { "type": "string" }, "part": { "type": "string" }, "position": { "$ref": "#/$defs/point" } } } }
            } },
          "house": { "type": "string", "description": "#2314: l, a, b or c for a stairwell door" },
          "level": { "type": "integer", "minimum": 0, "maximum": 1 },
          "hinge": { "$ref": "#/$defs/point" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "closed": { "$ref": "#/$defs/rotation" },
          "open": { "$ref": "#/$defs/rotation" },
          "centre": { "$ref": "#/$defs/point" },
          "size": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
        }
      }
    },
    "windows": {
      "type": "array",
      "items": { "type": "object", "required": ["ids", "level", "facade", "source", "rect", "sill", "head", "floorY"],
        "properties": { "ids": { "type": "array", "items": { "type": "string" }, "description": "the opening sashes' node ids" }, "facade": { "enum": ["north", "south"] }, "rect": { "type": "object", "required": ["x0", "x1", "z0", "z1"] } } }
    },
    "lights": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "kind", "level", "position"],
        "properties": { "kind": { "enum": ["lamp", "room"], "description": "lamp = a light-giving object or patio fence-string light; room = a room's ceiling/pendant light point (src/lights.js)" },
          "stairVisibility": { "description": "Lamp wash anchors within range of the stair and passage. An anchor outside both bounds retains only its weight in a multi-anchor lamp.",
            "type": "array", "items": { "type": "object", "required": ["weight"], "properties": {
              "origin": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }, "level": { "enum": [0, 1] },
              "split": { "type": "number" }, "viewerSplit": { "type": "number" }, "canPool": { "type": "boolean" }, "weight": { "type": "number", "minimum": 0 },
              "rays": { "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0 } } } } },
          "patioDusk": { "type": "object", "required": ["on", "off", "fade"], "properties": { "on": { "type": "number" }, "off": { "type": "number" }, "fade": { "type": "number", "exclusiveMinimum": 0 } } },
          "patioBulbs": { "type": "object", "required": ["idle", "boost"], "properties": { "idle": { "type": "number" }, "boost": { "type": "number" } } }, "position": { "$ref": "#/$defs/point" },
          "objectPosition": { "$ref": "#/$defs/point", "description": "World origin of the fitting that supplies a lamp. Its x/z identify anonymous fittings even when the light is offset." } } }
    },
    "terrain": { "type": "object", "required": ["file", "sha256", "x0", "z0", "step", "cols", "rows", "unit", "source", "licence"], "description": "a reference to data/elevation.json (grid origin/step/size and its hash), not a copy of the heights" },
    "site": {
      "type": "object", "required": ["geo", "planNorthDeg", "source"],
      "properties": {
        "livingWallCeilingAO": {
          "type": "object", "additionalProperties": false,
          "description": "#2372: only the actual painted east-wall ceiling-band triangles from built wall-ao; native display-space multiplication before ShadePools, no PBR or lamp fit.",
          "required": ["version", "target", "coordinates", "wall", "bandBottom", "coefficients", "depth", "triangles", "source", "coverage", "blendSpace", "runtimeCoverage"],
          "properties": {
            "version": { "const": 1 }, "target": { "const": "L1007 living-room painted east-wall ceiling band" },
            "coordinates": { "const": { "units": "metres", "axes": "x east, y up, z south" } },
            "wall": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "number" } },
            "bandBottom": { "type": "number" },
            "coefficients": { "type": "object", "required": ["floor", "ceil", "corner"], "additionalProperties": false,
              "properties": { "floor": { "$ref": "#/$defs/wallAOCoefficient" }, "ceil": { "$ref": "#/$defs/wallAOCoefficient" }, "corner": { "$ref": "#/$defs/wallAOCoefficient" } } },
            "depth": { "const": { "depthTest": true, "depthWrite": false, "frontSide": true, "polygonOffset": true, "polygonOffsetFactor": -2, "polygonOffsetUnits": -2, "renderOrder": 1, "toneMapped": false, "blend": "DstColor * source + Zero * destination" } },
            "triangles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["positions", "aDist"], "additionalProperties": false,
              "properties": {
                "positions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/vec3" } },
                "aDist": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } } }
              } } },
            "source": { "type": "string" }, "coverage": { "type": "string" },
            "blendSpace": { "const": "display-srgb-multiply" }, "runtimeCoverage": { "const": "static-built-geometry" }
          }
        },
        "windowDaylight": {
          "type": "object", "description": "#2394: L1007's actual window/well sources and 32-ray visibility from src/windowlight.js. Transmission and doors are explicitly an export snapshot, not live parity.",
          "required": ["version", "region", "runtimeCoverage", "coordinates", "config", "box", "bands", "sources", "segments", "snapshot", "limitations", "provenance"],
          "properties": {
            "version": { "const": 1 }, "region": { "const": "L1007" }, "runtimeCoverage": { "const": "export-snapshot" },
            "coordinates": { "type": "object", "required": ["units", "axes"], "properties": { "units": { "const": "metres" } } },
            "config": { "type": "object", "required": ["max", "rays", "base", "gain", "spread", "wrap", "glassWrap", "bounce", "bounceWrap", "warm", "tint", "skyWarm", "well", "sunGain", "sunClip", "sunMinHeight", "sunMaxArea", "sunWrap", "sunBeyond", "floor"], "properties": { "max": { "type": "integer", "minimum": 1 }, "rays": { "const": 32 } } },
            "runtimeColors": { "type": "object", "required": ["space", "skyDay", "skyNight", "sunLow", "sunHigh", "moon"], "properties": { "space": { "const": "linear-srgb" }, "skyDay": { "$ref": "#/$defs/vec3" }, "skyNight": { "$ref": "#/$defs/vec3" }, "sunLow": { "$ref": "#/$defs/vec3" }, "sunHigh": { "$ref": "#/$defs/vec3" }, "moon": { "$ref": "#/$defs/vec3" } } },
            "box": { "type": "object", "required": ["x0", "x1", "z0", "z1", "y0", "y1"] },
            "bands": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["level", "y0", "y1"] } },
            "sources": { "type": "array", "minItems": 1, "items": {
              "type": "object", "required": ["id", "kind", "level", "x", "y", "z", "nx", "nz", "hw", "hh", "ox", "oz", "y0", "y1", "share", "pass", "reach", "blindIds", "curtainIds"],
              "properties": {
                "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["window", "well"] }, "level": { "type": "integer", "minimum": 0 },
                "pass": { "type": "number", "minimum": 0, "maximum": 1 }, "share": { "type": "number", "minimum": 0, "maximum": 1 },
                "reach": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "number", "minimum": 0 } },
                "blindIds": { "type": "array", "items": { "type": ["string", "integer"] } }, "curtainIds": { "type": "array", "items": { "type": ["string", "integer"] } }
              }
            } },
            "segments": { "type": "array", "items": { "type": "object", "required": ["level", "segments"] } },
            "snapshot": { "type": "object", "required": ["doors", "blinds", "curtains"] },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "provenance": { "type": "object", "required": ["sources", "visibility", "wellTransmission"] }
          }
        },
        "livingWallLight": {
          "type": "object", "description": "L1007 painted east wall and the web window diffuse field. Metres in Unreal axis order. Samples are row-major from low to high, column along south.",
          "required": ["wall", "emitter", "glass", "columns", "rows", "field", "gain", "tint", "hemiOvercast", "hemiClear"],
          "properties": {
            "wall": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "number" } },
            "emitter": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "glass": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
            "columns": { "type": "integer", "minimum": 2 }, "rows": { "type": "integer", "minimum": 2 },
            "field": { "type": "array", "items": { "type": "number", "minimum": 0 } },
            "gain": { "type": "number", "exclusiveMinimum": 0 }, "tint": { "type": "integer" },
            "hemiOvercast": { "type": "number" }, "hemiClear": { "type": "number" }
          }
        },
        "leafLitter": {
          "type": "object", "description": "#2433: fallen autumn leaves (src/leaflitter.js, LEAF_LITTER): the web's density map over WALK as a grey PNG (row j at z0 + (j + 0.5) cell, column i at x0 + (i + 0.5) cell, web metres) and the ground patch's numbers. months, fresh and old run January to December; colours are linear RGB.",
          "required": ["source", "months", "fresh", "old", "kinds", "cells", "len", "wide", "aa", "mulch", "rough", "share", "density"],
          "properties": {
            "months": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
            "fresh": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } },
            "old": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } },
            "kinds": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
            "cells": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
            "len": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "aa": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "mulch": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "density": {
              "type": "object", "required": ["box", "cell", "width", "height", "hash", "png"],
              "properties": {
                "box": { "type": "object", "required": ["x0", "x1", "z0", "z1"] },
                "cell": { "type": "number", "exclusiveMinimum": 0 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
                "hash": { "type": "string", "description": "hash of the texels (not of the PNG bytes)" }, "png": { "type": "string" }
              }
            }
          }
        },
        "gravelSurface": {
          "type": "object", "description": "#2433: the shared gravel map (src/gravelsurface.js gravelData): an sRGB colour tile and a linear relief (R) / roughness (G) tile, `size` px per `tile` m of world-metre UVs, as base64 PNGs; `mean` is the colour map's linear mean that the web divides each surface's colour by.",
          "required": ["source", "tile", "mean", "depth", "roughness", "broadStrength", "broadScale", "size", "colorHash", "surfaceHash", "colorPng", "surfacePng"],
          "properties": {
            "tile": { "type": "number", "exclusiveMinimum": 0 }, "mean": { "type": "number", "exclusiveMinimum": 0 },
            "roughness": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
            "broadScale": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
            "size": { "type": "integer", "minimum": 1 }, "colorPng": { "type": "string" }, "surfacePng": { "type": "string" }
          }
        },
        "facadeLighting": {
          "type": "object", "description": "#2324: room and wall-light data for the requested building zones. Positions and lengths are in Unreal centimetres, normals are horizontal unit [X,Y], routine times are local hours.",
          "required": ["panes", "fixtures", "windows", "roomLevels", "facadeGlow", "wallLight", "schedule"],
          "properties": {
            "panes": { "type": "array", "items": { "type": "object", "required": ["house", "position", "normal", "halfWidth", "halfHeight", "depth", "floor", "ceiling", "left", "right", "dressing", "cover", "seed", "colours", "duskLit"] } },
            "fixtures": { "type": "array", "items": { "type": "object", "required": ["house", "kind", "position", "normal"] } },
            "windows": { "type": "array", "items": { "type": "object", "required": ["house", "position", "normal", "width", "height", "hall", "routine"] } },
            "surfaces": { "type": "array", "description": "the additive wall washes and ground pools (web triangles in Unreal cm, uv per vertex); colour is the web's sRGB hex, peak its full-fade opacity. #2397: courtyardBollardPools when gard is exported.",
              "items": { "type": "object", "required": ["name", "colour", "peak", "vertices", "indices"] } },
            "bollardLight": { "type": "object", "description": "#2397: the courtyard bollard pools' on/off night thresholds, fade seconds, colour and peak (src/config.js COURTYARD.bollards.pool)", "required": ["on", "off", "fade", "colour", "peak"] },
            "bollardBands": { "type": "object", "description": "#2430: the courtyard bollards' bands under the caps (src/courtyard.js; when gard is exported): lit sRGB hex while the night fraction is strictly above `on` with power, else `off`; upright band triangles in Unreal cm, 1 mm proud of the imported band, uv per vertex", "required": ["name", "on", "lit", "off", "vertices", "indices"] }
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "description": "material key → the web material's look (no web material has a name; the key is built from type, colour, roughness, metalness, opacity, emissive, vertex colours, textures, sides). Unreal maps keys to hand-made materials. Since #2308 `map` names the colour map (e.g. 'shared-grass-detail' on the lawns, src/grass.js) or is null. Since #2435 a web unlit label kept with its image (a `bas` key with `texture`) has `unlit: true` and `powerCut`, the share of its colour a power cut leaves on the web (1: unchanged).",
      "additionalProperties": { "type": "object", "required": ["type", "color", "roughness", "metalness", "opacity", "emissive", "vertexColors", "textured", "doubleSided", "hint"] }
    },
    "ground": {
      "type": "object", "required": ["source", "walkableName", "collision", "points", "route"],
      "description": "#2280: the walkable ground of the zones l1007-entre, gard and omgivning (export-scene.js groundProbes): the nodes build_site.py gives collision, control points with the elevation grid and the web's drawn terrain, and the walking route; tools/unreal-engine/tests/test_site.py traces and walks them. Optional: absent in exports without those zones.",
      "properties": {
        "collision": { "type": "array", "items": { "type": "object", "required": ["id", "zone", "name"] } },
        "points": { "type": "array", "items": { "type": "object", "required": ["id", "what", "x", "z", "reference", "unreal", "elevationY", "groundY", "terrainY", "hit"],
          "properties": { "reference": { "enum": ["elevation", "terrain"], "description": "elevation = the web's terrain is data/elevation.json here; terrain = the web's designed ground (courtyard, river valley)" } } } },
        "route": { "type": "array", "items": { "type": "object", "required": ["label", "x", "z", "unreal", "groundY", "hit"] } }
      }
    },
    "interaction": {
      "type": "object",
      "description": "#2285: the room switches (node id, room and level: a switch turns that room's lights on and off) the taps (outlet, landing point, pick point) and the lifts' buttons for Unreal's interaction builder (tools/unreal-engine/python/build_interaction.py). Optional: absent in older exports.",
      "required": ["switches", "taps", "source"],
      "properties": {
        "switches": { "type": "array", "items": { "type": "object", "required": ["id", "level", "room", "lamps", "position", "normal"],
          "properties": { "id": { "type": ["string", "null"] }, "level": { "type": "integer" }, "room": { "type": "string" },
            "lamps": { "type": "array", "items": { "type": "string" }, "description": "ids of the room's lights (measurements.json lights, kind room) = #2283's lamp:<id> actor tags" }, "position": { "$ref": "#/$defs/point" } } } },
        "taps": { "type": "array", "items": { "type": "object", "required": ["id", "name", "level", "shower", "outlet", "landing", "radius", "pick"],
          "properties": { "id": { "type": "string" }, "shower": { "type": "boolean" }, "outlet": { "$ref": "#/$defs/point" }, "landing": { "$ref": "#/$defs/point" }, "pick": { "$ref": "#/$defs/point" } } } },
        "liftButtons": { "type": "array", "description": "the lifts' car buttons (one per stop) and landing call buttons, src/liftpanel.js; house l/a/b/c", "items": { "type": "object", "required": ["id", "house", "kind", "stop", "position"],
          "properties": { "id": { "type": "string" }, "house": { "type": "string" }, "kind": { "enum": ["car", "call"] }, "stop": { "type": "integer" }, "position": { "$ref": "#/$defs/point" } } } },
        "source": { "type": "string" }
      }
    },
    "vegetation": {
      "type": "object", "required": ["source", "lobeReach", "treeClassM", "hedgeClassM", "trees", "hedges"],
      "description": "#2281: every exported tree (trunk node id, foot, crown radius, lobe count, height above the foot and height class) and hedge (node id, zone, box centre and size, height class); tools/unreal-engine/tests/test_vegetation.py finds each in Unreal. Optional: absent in exports without the vegetation zone.",
      "properties": {
        "trees": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "foot", "crownR", "lobes", "height", "heightClass"], "properties": { "foot": { "$ref": "#/$defs/point" },
          "blocks": { "type": ["number", "null"], "description": "#2308: half-width (m) of the diamond the web stops the walker with at this trunk (src/farwalk.js), null where the web does not block (inside the home block)" } } } },
        "trunkCollision": { "type": "object", "required": ["source", "shape", "halfWidth", "homeBlock", "walk"], "description": "#2308: the web's trunk blocking rule (src/farwalk.js; WALK.trunk by kind, OUTDOOR, WALK); build_vegetation.py builds it, test_vegetation.py walks into sampled trunks" },
        "hedges": { "type": "array", "items": { "type": "object", "required": ["id", "zone", "name", "centre", "size", "height", "heightClass"], "properties": { "centre": { "$ref": "#/$defs/point" } } } }
      }
    },
    "buildings": {
      "type": "array",
      "description": "#2279: measurement rays through Hus L, Hus A/B/C and the garage (export-scene.js buildingProbes), cast on the exported nodes of their zone; Unreal traces the same rays (tools/unreal-engine/tests/test_exterior.py). Optional: absent in exports without those zones.",
      "items": {
        "type": "object", "required": ["house", "zone", "id", "what", "from", "to", "expect", "web", "hit"], "additionalProperties": false,
        "properties": {
          "house": { "type": "string" }, "zone": { "type": "string" }, "id": { "type": "string" }, "what": { "type": "string" },
          "from": { "type": "array", "description": "Unreal cm" }, "to": { "type": "array", "description": "Unreal cm" },
          "expect": { "enum": ["hit", "clear", "glass"], "description": "clear = an intentional passage (no hit); glass = intentional glazing" },
          "web": { "type": "object", "required": ["from", "to"] },
          "hit": { "type": ["object", "null"], "description": "first hit: web (m), unreal (cm), distanceCm, node (export id), materialKey" }
        }
      }
    },
    "furnishing": {
      "type": "object",
      "description": "#2289: every exported furniture/appliance/lamp node's web world transform in web and Unreal terms (`items`; Unreal axes = the actor's forward/right/up unit vectors), and every base-colour texture the GLBs keep for furnishing materials (`textures`: id, the repository images it shows, material keys, nodes and mesh nodes with their world centre). Checked in Unreal by tools/unreal-engine/tests/test_furnishing.py.",
      "required": ["items", "textures"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "zone", "web", "unreal"] } },
        "parasols": { "type": "array", "minItems": 1, "description": "#2403 source canopy contract only; native runtime integration remains pending.", "items": {
          "type": "object", "required": ["id", "mesh", "zone", "radius", "tilt", "position", "exportedOpen", "folded", "opened", "rule", "geometry", "uv", "source", "scope"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "mesh": { "type": "string", "minLength": 1 }, "zone": { "const": "l1007-uteplats" },
            "radius": { "type": "number", "minimum": 0 }, "tilt": { "type": "number" }, "position": { "$ref": "#/$defs/vec3" }, "exportedOpen": { "type": "number", "minimum": 0, "maximum": 1 },
            "folded": { "$ref": "#/$defs/parasolPose" }, "opened": { "$ref": "#/$defs/parasolPose" },
            "rule": { "type": "object", "required": ["months", "radius", "height", "openHeight", "sunThreshold", "maxOvercast", "automaticSpeed", "manualSpeed", "sunComparison", "overcastComparison", "easing", "manual", "first"],
              "properties": { "months": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
                "radius": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }, "openHeight": { "type": "number", "minimum": 0 },
                "sunThreshold": { "type": "number" }, "maxOvercast": { "type": "number", "minimum": 0, "maximum": 1 }, "automaticSpeed": { "type": "number", "minimum": 0 }, "manualSpeed": { "type": "number", "minimum": 0 },
                "sunComparison": { "const": ">" }, "overcastComparison": { "const": "<=" }, "easing": { "const": "f*f*(3-2*f)" }, "manual": { "const": "holds until automatic state changes" }, "first": { "const": "snap to target" } } }
          }
        } },
        "displayPools": { "type": "object", "required": ["maskPng", "mask", "fields", "rugLamp", "rugReceivers", "source", "runtimeCoverage"],
          "description": "#2322: every actual L1007 ShadePools floor/ceiling quad, original linear mask/full-on tint, stable measurement light IDs and original rug exceptions. No PointLight slot selection.",
          "properties": { "maskPng": { "type": "string", "minLength": 1 }, "rugLamp": { "type": "string", "minLength": 1 },
            "mask": { "type": "object", "required": ["width", "height", "colorSpace", "flipY"], "properties": { "width": { "const": 128 }, "height": { "const": 128 }, "colorSpace": { "const": "linear" }, "flipY": { "const": true } } },
            "fields": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["lamp", "kind", "corners", "colour", "opacity", "depth", "source"],
              "properties": { "lamp": { "type": "string", "minLength": 1 }, "kind": { "enum": ["floor", "ceiling"] }, "corners": { "$ref": "#/$defs/uvQuad" }, "colour": { "$ref": "#/$defs/vec3" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "depth": { "$ref": "#/$defs/displayPoolDepth" }, "source": { "type": "string", "minLength": 1 } } } },
            "rugReceivers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "mesh", "key", "corners"], "properties": { "id": { "type": "string" }, "mesh": { "type": "string" }, "key": { "type": "string" }, "corners": { "$ref": "#/$defs/uvQuad" } } } },
            "source": { "type": "string", "minLength": 1 }, "runtimeCoverage": { "type": "object", "required": ["sourceLampCount", "fieldCount", "scope", "fade", "blend", "movement"],
              "properties": { "sourceLampCount": { "type": "integer", "minimum": 1 }, "fieldCount": { "type": "integer", "minimum": 1 }, "scope": { "type": "string" }, "fade": { "type": "string" }, "blend": { "type": "string" }, "movement": { "type": "string" } } }
          }
        },
        "rugFloorPool": { "type": "object", "required": ["lamp", "corners", "colour", "opacity", "maskPng", "mask", "depth", "receivers", "source", "scope"],
          "description": "#2322: the source pendant's linear additive floor quad (corners keyed by source UV, Unreal cm), full-on vertex colour and actual original rug top receiver. Native copied material adds source emission to that original receiver without recolouring, elevation or an intensity fit.",
          "properties": { "lamp": { "type": "string" }, "corners": { "$ref": "#/$defs/uvQuad" }, "colour": { "$ref": "#/$defs/vec3" }, "opacity": { "type": "number" }, "maskPng": { "type": "string", "minLength": 1 },
            "mask": { "type": "object", "required": ["width", "height", "colorSpace", "flipY"], "properties": { "width": { "type": "integer" }, "height": { "type": "integer" }, "colorSpace": { "const": "linear" }, "flipY": { "const": true } } },
            "depth": { "type": "object", "required": ["write", "test", "polygonOffset", "factor", "units", "renderOrder"] },
            "receivers": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "mesh", "key", "corners"], "properties": { "id": { "type": "string" }, "mesh": { "type": "string" }, "key": { "type": "string" }, "corners": { "$ref": "#/$defs/uvQuad" } } } }
          } },
        "curtains": { "type": "array", "items": { "type": "object", "required": ["id", "level", "room", "nodes", "key", "lamps", "daylight", "lamp"], "properties": {
          "id": { "type": "string" }, "level": { "type": "integer" }, "room": { "type": "string" }, "key": { "type": "string" },
          "nodes": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "lamps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "daylight": { "$ref": "#/$defs/vec3" }, "lamp": { "$ref": "#/$defs/vec3" }
        } } },
        "textures": { "type": "array", "items": { "type": "object", "required": ["id", "name", "kind", "images", "keys", "nodes", "meshes"] } },
        "patioBeers": { "type": "object", "required": ["glasses", "seasonal"], "description": "#2406: the slat table's two pints: each glass group node, its base and its meshes' world centres (web m, Unreal cm), and their date and hour window.",
          "properties": { "glasses": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "base", "meshes"] } }, "seasonal": { "type": "object", "required": ["what", "from", "to", "hours"] } } },
        "snowman": { "type": "object", "required": ["id", "zone", "position", "seasonal"], "description": "#2445: the snowman on the lawn beyond the patio hedge: its node id and zone, its origin (web m, Unreal cm) and its date window (src/patio.js snowmanOut).",
          "properties": { "id": { "type": "string" }, "zone": { "type": "string" }, "position": { "type": "object", "required": ["web", "unreal"] }, "seasonal": { "type": "object", "required": ["what", "from", "to"] } } }
      }
    },
    "fixture": {
      "type": "object", "required": ["points", "arrows"],
      "properties": {
        "points": { "type": "array", "minItems": 4, "items": { "type": "object", "required": ["id", "name", "web", "unreal"] } },
        "arrows": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "direction", "web", "unreal"] } }
      }
    }
  },
  "$defs": {
    "wallAOCoefficient": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
    "displayPoolDepth": { "type": "object", "required": ["write", "test", "polygonOffset", "factor", "units", "renderOrder"], "properties": { "write": { "const": false }, "test": { "const": true }, "polygonOffset": { "const": true }, "factor": { "type": "number" }, "units": { "type": "number" }, "renderOrder": { "type": "number" } } },
    "parasolPose": { "type": "object", "required": ["position", "scale", "rotationX"], "properties": { "position": { "$ref": "#/$defs/vec3" }, "scale": { "$ref": "#/$defs/vec3" }, "rotationX": { "type": "number" } } },
    "uvQuad": { "type": "object", "required": ["0,0", "1,0", "1,1", "0,1"], "additionalProperties": false, "properties": { "0,0": { "$ref": "#/$defs/vec3" }, "1,0": { "$ref": "#/$defs/vec3" }, "1,1": { "$ref": "#/$defs/vec3" }, "0,1": { "$ref": "#/$defs/vec3" } } },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "point": { "type": "object", "required": ["web", "unreal"], "properties": { "web": { "$ref": "#/$defs/vec3" }, "unreal": { "$ref": "#/$defs/vec3" } } },
    "rotation": { "type": "object", "required": ["webRotationY", "unrealYaw"], "additionalProperties": false,
      "properties": { "webRotationY": { "type": "number", "description": "radians about web +Y (three.js rotation.y; the leaf runs along (sin a, cos a))" }, "unrealYaw": { "type": "number", "description": "degrees; the leaf's direction from the hinge in Unreal" } } }
  }
}
