{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lunden platform-bound release manifest v1 (missing platform means legacy Windows)",
  "type": "object",
  "required": ["formatVersion", "channel", "published", "app", "content", "launcher"],
  "properties": {
    "formatVersion": { "const": 1 },
    "platform": { "enum": ["win-x64", "linux-x64"] },
    "channel": { "enum": ["test", "stable"] },
    "published": { "type": "string", "format": "date-time" },
    "app": {
      "type": "object",
      "required": ["version", "contentAbi", "minLauncher", "files"],
      "properties": {
        "version": { "$ref": "#/$defs/text" },
        "contentAbi": { "$ref": "#/$defs/text" },
        "minLauncher": { "$ref": "#/$defs/launcherVersion" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "content": {
      "type": "object",
      "required": ["version", "requiresAbi", "packages"],
      "properties": {
        "version": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "requiresAbi": { "$ref": "#/$defs/text" },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "files"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
            }
          }
        }
      }
    },
    "launcher": {
      "type": "object",
      "required": ["version", "url", "size", "sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/launcherVersion" },
        "url": { "$ref": "#/$defs/url" },
        "size": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "url": { "type": "string", "format": "uri" },
    "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "maxLength": 64 },
    "launcherVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$" },
    "file": {
      "type": "object",
      "required": ["path", "url", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$" },
        "url": { "$ref": "#/$defs/url" },
        "size": { "$ref": "#/$defs/size" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "authenticode": { "type": "boolean" },
        "executable": { "type": "boolean" }
      }
    }
  }
}
