{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/solwation/lunden-3d-apartment/shared/schema/export-manifest.schema.json",
  "title": "Lunden web → Unreal export manifest (#2245)",
  "description": "export-manifest.json written by tools/unreal-engine/export-world.mjs next to the zone GLBs and measurements.json. Lists every exported file with its SHA-256 and every source file the export was built from, so tools/unreal-engine/check-export.mjs can tell when the Unreal import is stale. formatVersion is bumped for any incompatible change (shared/README.md).",
  "type": "object",
  "required": ["formatVersion", "kind", "generator", "sourceCommit", "sourceDirty", "sourceHash", "settings", "files", "sources"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "lunden-export-manifest" },
    "generator": { "type": "string" },
    "sourceCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$", "description": "git HEAD when exported (null outside a Git checkout)" },
    "sourceDirty": { "type": "boolean", "description": "true when a listed source file had uncommitted changes: the export is then not reproducible from sourceCommit" },
    "sourceHash": { "$ref": "#/$defs/sha256", "description": "SHA-256 over the lines '<sha256>  <path>\\n' of `sources`, in order" },
    "settings": {
      "type": "object",
      "required": ["fixedTime", "randomSeed", "three", "zones"],
      "additionalProperties": false,
      "properties": {
        "fixedTime": { "type": "string", "description": "the page's fixed Date (ISO 8601)" },
        "randomSeed": { "type": "integer", "description": "seed of the page's Math.random (mulberry32)" },
        "three": { "type": "string", "description": "three.js version used by the exporter" },
        "zones": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "zone", "sha256", "bytes", "nodes", "triangles"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "file name in the export directory" },
          "kind": { "enum": ["glb", "measurements"] },
          "zone": { "type": ["string", "null"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "nodes": { "type": ["integer", "null"], "minimum": 0 },
          "triangles": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "repository-relative path" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
