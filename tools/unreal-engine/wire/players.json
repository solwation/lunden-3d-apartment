{
  "about": "Fixed wire fixtures of the players' room /players (#2292). Played by cloudflare/playerswire.test.mjs against the real Worker; the Unreal client test (#2292) plays the same steps. Rules: tools/unreal-engine/wire/README.md.",
  "endpoint": {
    "path": "/players",
    "query": {"n":"display name (cleaned by the room)","a":"optional per-tab away token, 12–32 of [a-z0-9]; never relayed"},
    "upgrade": "websocket",
    "origin": "a request with an Origin header must come from the site; none (a native client) is accepted"
  },
  "clock": {"start":"2026-11-21T12:00:00.000Z","note":"advance steps move the room's clock (Date.now) on Node; a live run waits at least that long"},
  "relevantTypes": ["w","j","s","x"],
  "heartbeat": {"send":"p","reply":"q"},
  "limits": {
    "maxBytes": 512,
    "perSecond": 6,
    "strikes": 5,
    "idleMs": 60000,
    "maxPlayers": 30,
    "nameMax": 20,
    "monthlyCap": 800000,
    "msgPerRequest": 20,
    "awayMs": 120000,
    "lives": 10,
    "clientHz": 5,
    "clientBeatMs": 10000
  },
  "closeCodes": {"idle":4000,"cap":4001,"off":4003,"rate":4008,"full":4029,"big":1009,"away":4100},
  "coordinates": {
    "web": "metres, right-handed: x east, y up, z south (north = -z); p = the feet; r = yaw in radians (camera.rotation.y: 0 looks north, +pi/2 west); look = [head yaw relative to r, pitch] in radians (pitch > 0 looks up)",
    "unreal": "centimetres: X = 100 x (east), Y = 100 z (south), Z = 100 y (up); yaw in degrees = -90 - deg(r), normalised to (-180, 180]; pitch unchanged in degrees; a relative head yaw changes sign. tools/unreal-engine/coordinates.mjs, docs/development/unreal.md",
    "rounding": "the room rounds p, r and look to 0.01 (1 cm, 0.01 rad) before relaying",
    "cases": [
      {
        "name": "Anna in join-state-leave (west-facing)",
        "web": {"p":[12.35,0,-3.21],"r":1.57},
        "unreal": {"feetCm":[1235,-321,0],"yawDeg":-179.95}
      },
      {"name":"Olof in join-state-leave","web":{"p":[2,0,3],"r":-1},"unreal":{"feetCm":[200,300,0],"yawDeg":-32.7}},
      {
        "name": "standing, looking north and up",
        "web": {"p":[1,0,1],"r":0,"look":[0,0.25]},
        "unreal": {"feetCm":[100,100,0],"yawDeg":-90,"pitchDeg":14.32,"headYawDeg":0}
      },
      {
        "name": "seated, facing south, head turned left, looking down",
        "web": {"p":[1,0.45,1],"r":3.14,"look":[0.4,-0.3]},
        "unreal": {"feetCm":[100,100,45],"yawDeg":90.09,"pitchDeg":-17.19,"headYawDeg":-22.92}
      },
      {"name":"away-and-back","web":{"p":[3,0,4],"r":1},"unreal":{"feetCm":[300,400,0],"yawDeg":-147.3}},
      {
        "name": "a Windows player facing east (Unreal yaw 0)",
        "web": {"p":[-4.5,1.2,7.25],"r":-1.57},
        "unreal": {"feetCm":[-450,725,120],"yawDeg":-0.05}
      }
    ]
  },
  "scenarios": [
    {
      "id": "join-state-leave",
      "title": "native and web clients: welcome with peer id, join, cleaned and rounded states, junk dropped, heartbeat, leave",
      "steps": [
        {"op":"connect","client":"A","name":"Anna","note":"no Origin header: a native (Windows) client"},
        {"op":"expect","client":"A","messages":[{"t":"w","i":"$A","l":10,"ps":[]}]},
        {"op":"send","client":"A","json":{"p":[12.346,0.004,-3.214],"r":1.5708,"score":0}},
        {"op":"expect","client":"A","messages":[],"note":"a state is never echoed to its sender"},
        {
          "op": "connect",
          "client": "B",
          "name": "Olof<b>",
          "origin": "https://solwation.github.io",
          "note": "a web page; the name is cleaned (no < > & \" or control characters, at most nameMax)"
        },
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"w","i":"$B","l":10,"ps":[{"i":"$A","n":"Anna","p":[12.35,0,-3.21],"r":1.57,"score":0,"h":"","l":10}]}]
        },
        {"op":"expect","client":"A","messages":[{"t":"j","i":"$B","n":"Olofb","l":10}]},
        {"op":"send","client":"B","json":{"p":[2,0,3],"r":-1}},
        {"op":"expect","client":"A","messages":[{"t":"s","i":"$B","p":[2,0,3],"r":-1,"score":0,"h":"","l":10}]},
        {
          "op": "send",
          "client": "B",
          "texts": ["not json",{"p":[1,2],"r":0},{"p":[1000000000,0,0],"r":0},{"p":[0,0,0]}],
          "note": "malformed states are dropped silently"
        },
        {"op":"expect","client":"A","messages":[]},
        {"op":"send","client":"B","text":"p","note":"the heartbeat, answered by the runtime without waking the room"},
        {"op":"expect","client":"B","messages":["q"]},
        {"op":"expect","client":"A","messages":[]},
        {"op":"close","client":"B","code":1000},
        {"op":"expect","client":"A","messages":[{"t":"x","i":"$B"}]}
      ]
    },
    {
      "id": "appearance-and-pose",
      "title": "optional look and pose fields: kept when valid, dropped when not",
      "steps": [
        {"op":"connect","client":"A","name":"Anna"},
        {"op":"connect","client":"B","name":"Bo"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {
          "op": "send",
          "client": "A",
          "json": {"p":[1,0,1],"r":0,"score":12.7,"h":"nerf","c":true,"look":[0,0.25],"jp":1,"dn":2,"av":"120310101175","ax":"u1","junk":"x"}
        },
        {
          "op": "expect",
          "client": "B",
          "messages": [
            {
              "t": "s",
              "i": "$A",
              "look": [0,0.25],
              "p": [1,0,1],
              "r": 0,
              "score": 12,
              "h": "nerf",
              "c": true,
              "jp": 1,
              "dn": 2,
              "av": "120310101175",
              "ax": "u1",
              "l": 10
            }
          ]
        },
        {
          "op": "send",
          "client": "A",
          "json": {"p":[1,0,1],"r":0,"h":"bazooka","c":"yes","pose":7,"look":[0.5,0],"av":"99","ax":"u1"},
          "note": "unknown weapon, non-boolean crouch, unknown pose, a standing head turn, an invalid look code (and so its extension)"
        },
        {"op":"expect","client":"B","messages":[{"t":"s","i":"$A","p":[1,0,1],"r":0,"score":0,"h":"","l":10}]},
        {"op":"send","client":"A","json":{"p":[1,0.45,1],"r":3.1416,"pose":1,"look":[0.4,-0.3],"av":"1203101"}},
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"s","i":"$A","look":[0.4,-0.3],"p":[1,0.45,1],"r":3.14,"score":0,"h":"","pose":1,"av":"1203101","l":10}]
        }
      ]
    },
    {
