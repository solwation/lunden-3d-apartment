    {
      "id": "size-limit",
      "title": "a message of maxBytes characters passes; one more closes with 1009",
      "steps": [
        {"op":"connect","client":"A","name":"Anna"},
        {"op":"connect","client":"B","name":"Bo"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {
          "op": "send",
          "client": "A",
          "text": "{\"p\":[0,0,0],\"r\":0,\"pad\":\"\"}"
        },
        {"op":"expect","client":"B","messages":[{"t":"s","i":"$A","p":[0,0,0],"r":0,"score":0,"h":"","l":10}]},
        {
          "op": "send",
          "client": "A",
          "text": "{\"p\":[0,0,0],\"r\":0,\"pad\":\"\"}"
        },
        {"op":"expect","client":"A","closed":1009},
        {"op":"expect","client":"B","messages":[{"t":"x","i":"$A"}]}
      ]
    },
    {
      "id": "idle-and-heartbeat",
      "title": "silent longer than idleMs: closed 4000 on the next traffic; a heartbeat counts as alive",
      "steps": [
        {"op":"connect","client":"A","name":"Anna"},
        {"op":"connect","client":"B","name":"Bo"},
        {"op":"connect","client":"C","name":"Cia"},
        {"op":"expect","client":"A","messages":[{"t":"w","i":"$A"},{"t":"j","i":"$B","n":"Bo","l":10},{"t":"j","i":"$C","n":"Cia","l":10}]},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"},{"t":"j","i":"$C","n":"Cia","l":10}]},
        {"op":"expect","client":"C","messages":[{"t":"w","i":"$C"}]},
        {"op":"advance","ms":50000},
        {"op":"send","client":"B","text":"p"},
        {"op":"expect","client":"B","messages":["q"]},
        {"op":"advance","ms":11000},
        {
          "op": "send",
          "client": "A",
          "json": {"p":[5,0,5],"r":0},
          "note": "traffic runs the sweep: C (silent 61 s) is closed, B (heartbeat 11 s ago) stays"
        },
        {"op":"expect","client":"C","closed":4000},
        {
          "op": "expect",
          "client": "B",
          "closed": null,
          "messages": [{"t":"s","i":"$A","p":[5,0,5],"r":0,"score":0,"h":"","l":10},{"t":"x","i":"$C"}]
        },
        {"op":"expect","client":"A","closed":null,"messages":[{"t":"x","i":"$C"}]}
      ]
    },
    {
      "id": "away-and-back",
      "title": "close 4100 with a tab token: shown away (aw: 1, unarmed), also to a newcomer; back within awayMs: the same id, no join, no leave",
      "steps": [
        {"op":"connect","client":"A","name":"Anna","token":"annatoken000001"},
        {"op":"connect","client":"B","name":"Bertil"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {"op":"send","client":"A","json":{"p":[3,0,4],"r":1,"score":5,"h":"nerf"}},
        {"op":"expect","client":"B","messages":[{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":5,"h":"nerf","l":10}]},
        {"op":"close","client":"A","code":4100,"reason":"away"},
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":5,"l":10,"aw":1}],
          "note": "no leave; the token is never relayed"
        },
        {"op":"connect","client":"C","name":"Cia"},
        {
          "op": "expect",
          "client": "C",
          "messages": [{"t":"w","i":"$C","ps":[{"i":"$B","n":"Bertil","l":10},{"i":"$A","n":"Anna","p":[3,0,4],"r":1,"score":5,"l":10,"aw":1}]}]
        },
        {"op":"expect","client":"B","messages":[{"t":"j","i":"$C","n":"Cia","l":10}]},
        {"op":"advance","ms":30000},
        {"op":"connect","client":"A2","name":"Anna","token":"annatoken000001","note":"the same tab token and name within awayMs"},
        {
          "op": "expect",
          "client": "A2",
          "sameId": "A",
          "messages": [{"t":"w","i":"$A","ps":[{"i":"$B","n":"Bertil","l":10},{"i":"$C","n":"Cia","l":10}]}]
        },
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":5,"l":10}],
          "note": "the kept (unarmed) state again without aw: no join, no leave"
        },
        {"op":"expect","client":"C","messages":[{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":5,"l":10}]},
        {"op":"close","client":"A2","code":1000},
        {"op":"expect","client":"B","messages":[{"t":"x","i":"$A"}]}
      ]
    },
    {
      "id": "away-expires",
      "title": "away longer than awayMs: the leave comes with aw: 1 on the next traffic (or the room alarm)",
      "steps": [
        {"op":"connect","client":"A","name":"Anna","token":"annatoken000001"},
        {"op":"connect","client":"B","name":"Bertil"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {"op":"send","client":"A","json":{"p":[3,0,4],"r":1}},
        {"op":"close","client":"A","code":4100,"reason":"away"},
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":0,"h":"","l":10},{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":0,"l":10,"aw":1}]
        },
        {"op":"advance","ms":50000},
        {"op":"send","client":"B","json":{"p":[0,0,9],"r":0}},
        {"op":"advance","ms":50000},
        {"op":"send","client":"B","json":{"p":[0,0,9],"r":0.5}},
        {"op":"expect","client":"B","messages":[]},
        {"op":"advance","ms":20000},
        {"op":"send","client":"B","json":{"p":[0,0,9],"r":1}},
        {"op":"expect","client":"B","messages":[{"t":"x","i":"$A","aw":1}]}
      ]
    },
    {
      "id": "away-other-name",
      "title": "the same tab token under another name: the away player leaves at once, a new player joins",
      "steps": [
        {"op":"connect","client":"A","name":"Anna","token":"annatoken000001"},
        {"op":"connect","client":"B","name":"Bertil"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {"op":"send","client":"A","json":{"p":[3,0,4],"r":1}},
        {"op":"close","client":"A","code":4100,"reason":"away"},
        {
          "op": "expect",
          "client": "B",
          "messages": [{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":0,"h":"","l":10},{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":0,"l":10,"aw":1}]
        },
        {"op":"connect","client":"A2","name":"Annika","token":"annatoken000001"},
        {"op":"expect","client":"A2","newId":"A","messages":[{"t":"w","i":"$A2","ps":[{"i":"$B","n":"Bertil","l":10}]}]},
        {"op":"expect","client":"B","messages":[{"t":"x","i":"$A","aw":1},{"t":"j","i":"$A2","n":"Annika","l":10}]}
      ]
    },
    {
      "id": "away-without-token",
      "title": "close 4100 without a token (an old client): a plain leave",
      "steps": [
        {"op":"connect","client":"A","name":"Anna"},
        {"op":"connect","client":"B","name":"Bertil"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {"op":"send","client":"A","json":{"p":[3,0,4],"r":1}},
        {"op":"close","client":"A","code":4100,"reason":"away"},
        {"op":"expect","client":"B","messages":[{"t":"s","i":"$A","p":[3,0,4],"r":1,"score":0,"h":"","l":10},{"t":"x","i":"$A"}]}
      ]
    },
    {
      "id": "origin",
      "title": "a browser page from another site is refused (403); no Origin (a native client) and the site are accepted",
      "steps": [
        {"op":"connect","client":"E","name":"Eve","origin":"https://evil.example","status":403},
        {"op":"connect","client":"W","name":"Web","origin":"https://solwation.github.io"},
        {"op":"expect","client":"W","messages":[{"t":"w","i":"$W","ps":[]}]},
        {"op":"connect","client":"N","name":"Native"},
        {"op":"expect","client":"N","messages":[{"t":"w","i":"$N","ps":[{"i":"$W","n":"Web","l":10}]}]}
      ]
    },
    {
      "id": "monthly-cap",
      "title": "the month's billed requests reach monthlyCap: every socket closes with 4001 and new ones are refused",
      "nodeOnly": "setBill presets the room's counter; against a running Worker wait for the cap instead or skip",
      "steps": [
        {"op":"connect","client":"A","name":"Anna"},
        {"op":"connect","client":"B","name":"Bo"},
        {"op":"expect","client":"B","messages":[{"t":"w","i":"$B"}]},
        {"op":"setBill","req":799999,"msg":18,"note":"monthlyCap - 1 requests and msgPerRequest - 2 messages"},
        {"op":"send","client":"A","json":{"p":[1,0,0],"r":0}},
        {"op":"expect","client":"B","messages":[{"t":"s","i":"$A","p":[1,0,0],"r":0,"score":0,"h":"","l":10}]},
        {"op":"send","client":"A","json":{"p":[2,0,0],"r":0},"note":"this message reaches the cap: not relayed"},
        {"op":"expect","client":"A","closed":4001},
        {"op":"expect","client":"B","closed":4001,"messages":[{"t":"x","i":"$A"}]},
        {"op":"connect","client":"C","name":"Cia"},
        {"op":"expect","client":"C","closed":4001,"messages":[],"note":"accepted and at once closed: no welcome"}
      ]
    }
  ]
}
