diff --git a/tools/unreal-engine/tests/test_brick_filter.py b/tools/unreal-engine/tests/test_brick_filter.py
new file mode 100644
index 0000000000000000000000000000000000000000..688e421b691be635354367c9730bbafbf19daab6
--- /dev/null
+++ b/tools/unreal-engine/tests/test_brick_filter.py
@@ -0,0 +1,143 @@
+"""#2428: execute the actual HLSL scalar kernels as C++ and compare numerical integration.
+
+No Unreal/GPU. Requires a C++ compiler (CXX or c++); all build output is temporary.
+Checks periodic/negative phases, subpixel full boxes, resolved tents, running bond,
+mean coverage and unchanged non-brick shader inputs. Native compilation/images remain separate.
+"""
+import ast
+import ctypes
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import random
+import re
+import subprocess
+import tempfile
+import unittest
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def constant(name):
+    tree = ast.parse((ROOT/'tools/unreal-engine/python/build_materials.py').read_text())
+    return next(ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign)
+                and any(isinstance(t, ast.Name) and t.id == name for t in n.targets))
+
+
+def frac(x):
+    return x-math.floor(x)
+
+
+def smooth(a,b,x):
+    t=max(0,min(1,(x-a)/(b-a)))
+    return t*t*(3-2*t)
+
+
+def reference(c,width,support,tent,n=8192):
+    # Independent midpoint quadrature of the periodic indicator, not its antiderivative.
+    total=0.0
+    for i in range(n):
+        x=(i+.5)/n-.5
+        weight=2*(1-2*abs(x)) if tent else 1
+        total += weight * (frac(c+x*support)<width)
+    return total/n
+
+
+class BrickFilterTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory=tempfile.TemporaryDirectory()
+        code=constant('BRICK_FILTER')
+        start=code.index('struct BrickTent {')
+        end=code.index('\n    BrickTent brickTent;',start)
+        kernel=code[start:end].replace('float4','float').replace('[unroll]','')
+        box=code[code.index('    float4 lo ='):code.index('    struct BrickTent')].replace('float4','float')
+        source='''#include <algorithm>
+#include <cmath>
+using std::min;using std::max;using std::floor;using std::abs;
+float frac(float x){return x-floor(x);}
+float saturate(float x){return std::clamp(x,0.f,1.f);}
+float step(float e,float x){return x>=e?1.f:0.f;}
+float lerp(float a,float b,float t){return a+(b-a)*t;}
+'''+kernel+'''
+extern "C" float tent(float c,float w,float s){BrickTent f;return f.face(c,w,s);}
+extern "C" float box(float center,float faceWidth,float span){
+'''+box+'return coverage;}\n'
+        # HLSL literals are float; C++ decimal literals need the same type for min/max.
+        source=re.sub(r'(?<![\w.])(\d+\.\d+)(?![\w.])',r'\1f',source)
+        folder=Path(cls.directory.name);cpp=folder/'filter.cpp';cpp.write_text(source)
+        library=folder/'filter.so'
+        subprocess.run([os.environ.get('CXX','c++'),'-std=c++17','-shared','-fPIC','-O2',str(cpp),'-o',str(library)],check=True,capture_output=True,text=True)
+        cls.library=ctypes.CDLL(str(library))
+        for name in ('box','tent'):
+            f=getattr(cls.library,name);f.argtypes=[ctypes.c_float]*3;f.restype=ctypes.c_float
+        cls.code=code
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.directory.cleanup()
+
+    def test_actual_kernels_against_independent_quadrature(self):
+        rng=random.Random(2428)
+        for tent in (False,True):
+            for i in range(100):
+                gap=rng.uniform(.01,.4);w=1-gap
+                support=rng.uniform(.0001,2*gap) if tent else rng.uniform(.0001,5)
+                c=rng.uniform(-.5*gap,1-.5*gap)
+                if i<8:c=[-.5*gap,0,w,1,w+support*.2,1-support*.2,.5,w-support*.2][i]
+                got=getattr(self.library,'tent' if tent else 'box')(c,w,support)
+                self.assertAlmostEqual(got,reference(c,w,support,tent),delta=.001)
+
+    def test_resolution_gate_and_quadrature_blur(self):
+        self.assertIn('sqrt(pixel * pixel + TexelBlur * TexelBlur) / S',self.code)
+        self.assertIn('smoothstep(0.5, 0.8,',self.code)
+        for joint_pixels in (0,.1,.499,.5):self.assertEqual(smooth(.5,.8,joint_pixels),0)
+        self.assertEqual(smooth(.5,.8,.8),1)
+        # No global footprint shrink or source-colour/jitter edits.
+        self.assertNotIn('0.7 * footprint',self.code)
+        for name in ('Variation','Grain','HueJitter','SaturationJitter','LightnessJitter'):
+            self.assertIn(name+' *= detail;',self.code)
+
+    def test_only_tiled_master_requires_new_asset_stamp(self):
+        # Execute the production hash function for the complete tiled family. None reads
+        # a collection/engine-dependent graph; rebuilding a parent must not dirty its MIs.
+        tree=ast.parse((ROOT/'tools/unreal-engine/python/build_materials.py').read_text())
+        function=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='spec_hash')
+        env={name:constant(name) for name in ('TILED_GRID','TILED_FINISH','TILED_HSL','BRICK_FILTER',
+                                               'BAKED','GLTF_VC','GLTF_LABEL','GLTF_FORWARD')}
+        env.update(hashlib=hashlib,json=json,collection_reads=lambda spec:{},
+                   backdrop_material=SimpleNamespace(GRAPH='landscape-backdrop'))
+        exec(compile(ast.Module(body=[function],type_ignores=[]),'<production spec_hash>','exec'),env)
+        table=json.loads((ROOT/'tools/unreal-engine/material-map.json').read_text())['materials']
+        master='/Game/Lunden/Materials/M_LundenTiled'
+        family={p:s for p,s in table.items() if p==master or s.get('parent')==master}
+        current={p:env['spec_hash'](p,s) for p,s in family.items()}
+        env['BRICK_FILTER']='previous-filter'
+        changed=[p for p,s in family.items() if env['spec_hash'](p,s)!=current[p]]
+        self.assertEqual(changed,[master])
+        self.assertEqual(len(family),19)
+
+    def test_running_bond_integral_and_mean(self):
+        rng=random.Random(2318)
+        for i in range(12):
+            gx,gy=.08,.12
+            sx,sy=rng.uniform(.02,.18),rng.uniform(.02,.22)
+            x,y=rng.random(),rng.random()
+            fx=1-gx;fy=.5*(1-gy)
+            xs=[x-.5*gx,frac(x+.5)-.5*gx]
+            ys=[y-.25*gy,frac(y+.5)-.25*gy]
+            # Separable tent applied to the actual two alternating-row rectangles.
+            got=1-sum(self.library.tent(c,fx,sx)*self.library.tent(d,fy,.5*sy) for c,d in zip(xs,ys))
+            ref=1-sum(reference(c,fx,sx,True,4096)*reference(d,fy,.5*sy,True,4096) for c,d in zip(xs,ys))
+            self.assertAlmostEqual(got,ref,delta=.0015)
+        # Normalized kernels preserve the actual periodic face mean; no fog-area gain.
+        for support in (.0001,.05,.3):
+            values=[self.library.tent((i+.5)/4096, .82, support) for i in range(4096)]
+            self.assertAlmostEqual(sum(values)/len(values),.82,delta=.0003)
+
+
+if __name__=='__main__':
+    unittest.main()
