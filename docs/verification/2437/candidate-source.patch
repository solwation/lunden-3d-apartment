+struct float3 {float r,g,b;float3(float x,float y,float z):r(x),g(y),b(z){} void operator*=(float f){r*=f;g*=f;b*=f;}};
+struct float4 {float3 rgb;};
+float smoothstep(float a,float b,float v){float t=fmin(1.f,fmax(0.f,(v-a)/(b-a)));return t*t*(3.f-2.f*t);}
+float4 lerp(float4 a,float4 b,float t){return {{a.rgb.r+(b.rgb.r-a.rgb.r)*t,a.rgb.g+(b.rgb.g-a.rgb.g)*t,a.rgb.b+(b.rgb.b-a.rgb.b)*t}};}
+float4 Texture2DSample(int,int,float2 uv){float u=uv.x-floor(uv.x),v=uv.y-floor(uv.y);return {{.2f+.3f*u,.3f+.2f*v,.1f+.2f*u+.1f*v}};}
+int main(){float x,y;std::cout<<std::setprecision(10);while(std::cin>>x>>y){float2 UV(x,y);int GrassDetail=0,GrassDetailSampler=0;
+"""+grass_detail.source_hlsl()+r"""
