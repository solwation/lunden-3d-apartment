diff --git a/docs/verification/2437/source-integration.md b/docs/verification/2437/source-integration.md
new file mode 100644
index 00000000..bfc86cea
--- /dev/null
+++ b/docs/verification/2437/source-integration.md
@@ -0,0 +1,41 @@
+# Source integration checkpoint
+
+The current candidate replaces the procedural grass texture approximation with
+`src/grass.js grassTexture()`'s actual 256×256 Canvas PNG. The lightweight exporter
+imports that function without a renderer or world; its JSON records source hashes,
+actual GRASS configuration, Three revision, PNG/RGBA hashes and texture settings.
+The normal builder/check refuse stale source metadata or PNG bytes. Regenerate with
+`tools/browsertest.sh node tools/unreal-engine/export-grass-detail.cjs`, using the
+project's pinned Three 0.170.0 and the approved Chromium executable/environment.
+
+`grass_detail.py` builds/checks the sRGB, wrapping, uncompressed BGRA8 texture
+`/Game/Lunden/Materials/Textures/T_LundenGrassDetail`. Its HLSL ports the actual
+`grassBlendGLSL` two lookups and the broad grass.js brightness/blue-warmth patch.
+The raw Canvas PNG has top row first; source `Texture.flipY` is true, so both
+native lookups sample `(u, 1-v)`. The glTF exporter leaves UV attributes unchanged;
+UE5.8.4 GLTFCore GetTexCoords reads accessor Vec2 values and MeshFactory assigns
+them directly to VertexInstanceUVs. No image-dependent UV adjustment is used.
+Seasonal tint, vertex-colour/river-bed routing and the leaf-litter tail remain.
+Old instance parameters stay available for compatibility without resaving MIs.
+
+The unchanged material-map.json assumption text describes the historical
+procedural approximation. This candidate supersedes its texture/transfer/patch
+parts; preserving those bytes avoids invalidating all ten zone import hashes.
+No new export/import of the world, Lighting rebuild or source colour/gain change
+is required. Only the grass master fingerprint and the new texture change here.
+
+Four CPU checks exercise decoded PNG texel identity, fail-closed source/PNG
+changes, emitted HLSL float32 execution of both lookups/UV orientation/broad
+patch against independent equations, and the preserved seasonal/river/litter
+routing. CPU compilation does not prove GPU compilation or image acceptance.
+The existing grass-material configuration check also passes.
+
+Historical v1 (`7d4ed436`, original worker `ecead854`) corrected gamma in the
+procedural approximation. Its three scalar checks passed, but actual Native
+v1 grass was 127/189/84 versus web 112/173/65: original channel tolerance failed.
+Those commits/results remain preserved. The obsolete scalar-transfer test is
+removed because the runtime now samples the source sRGB texture instead.
+
+Root owns the controlled texture/master build, normal material --check and
+original paired entrance/courtyard captures. Original grass RGB ±10% and crown
+saturation ±15% remain unchanged; no whole-issue or Shipping acceptance is claimed.
diff --git a/tools/unreal-engine/export-grass-detail.cjs b/tools/unreal-engine/export-grass-detail.cjs
new file mode 100644
index 00000000..129c34a6
--- /dev/null
+++ b/tools/unreal-engine/export-grass-detail.cjs
@@ -0,0 +1,39 @@
+// #2437: one source Canvas, no WebGL renderer, main.js or world construction.
+const fs=require('node:fs'),path=require('node:path'),http=require('node:http'),crypto=require('node:crypto');
+const {chromium}=require(process.env.PLAYWRIGHT_MODULE||'playwright');
+const root=path.resolve(__dirname,'../..'),out=path.resolve(process.argv[2]||path.join(__dirname,'grass-detail'));
+const three=process.env.THREE_MODULE||path.join(root,'node_modules/three/build/three.module.js');
+const digest=b=>crypto.createHash('sha256').update(b).digest('hex');
+async function main(){
+ const server=http.createServer((req,res)=>{try{
+  const url=new URL(req.url,'http://localhost');let file;
+  if(url.pathname==='/'){res.setHeader('Content-Type','text/html');return res.end('<script type="importmap">{"imports":{"three":"/vendor/three.module.js"}}</script>');}
+  if(url.pathname.startsWith('/vendor/'))file=path.join(path.dirname(three),path.basename(url.pathname));
+  else file=path.resolve(root,'.'+decodeURIComponent(url.pathname));
+  if(!file.startsWith(root+'/')&&!file.startsWith(path.dirname(three)+'/'))throw Error('path');
+  res.setHeader('Content-Type','text/javascript');res.end(fs.readFileSync(file));
+ }catch(e){res.statusCode=404;res.end(String(e));}});
+ await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));let browser;
+ try{
+  browser=await chromium.launch({executablePath:process.env.CHROME_PATH,args:['--no-sandbox']});
+  const page=await browser.newPage();await page.goto(`http://127.0.0.1:${server.address().port}/`);
+  const data=await page.evaluate(async()=>{
+   const THREE=await import('three'),{grassTexture}=await import('/src/grass.js');
+   const {GRASS}=await import('/src/config.js'),{grassBlendGLSL}=await import('/src/grassdetail.js');
+   const t=grassTexture(),c=t.image,bytes=Array.from(c.getContext('2d').getImageData(0,0,c.width,c.height).data);
+   if(THREE.REVISION!=='170'||t.colorSpace!==THREE.SRGBColorSpace||!t.flipY)throw Error('source texture contract');
+   return {png:c.toDataURL('image/png').split(',')[1],rgba:bytes,width:c.width,height:c.height,config:GRASS,
+    blendGLSL:grassBlendGLSL(GRASS.tile,GRASS.detailBlend),threeRevision:THREE.REVISION,flipY:t.flipY,
+    repeat:t.repeat.toArray(),anisotropy:t.anisotropy,colorSpace:t.colorSpace};
+  });
+  const sources={},seen=new Set();function visit(rel){if(seen.has(rel))return;seen.add(rel);
+   const bytes=fs.readFileSync(path.join(root,rel));sources[rel]=digest(bytes);
+   for(const match of bytes.toString().matchAll(/(?:from\s*|import\s*)['"](\.[^'"]+)['"]/g))visit(path.posix.normalize(path.posix.join(path.posix.dirname(rel),match[1])));
+  }visit('src/grass.js');visit('src/grassdetail.js');
+  sources['tools/unreal-engine/export-grass-detail.cjs']=digest(fs.readFileSync(__filename));
+  const png=Buffer.from(data.png,'base64');delete data.png;data.rgbaSHA256=digest(Buffer.from(data.rgba));delete data.rgba;
+  Object.assign(data,{version:1,sourceFiles:sources,pngSHA256:digest(png),threeModuleSHA256:digest(fs.readFileSync(three)),pngOrientation:'raw source Canvas top row first; shader honors texture.flipY',browserVersion:browser.version()});
+  fs.mkdirSync(out,{recursive:true});fs.writeFileSync(path.join(out,'grass-detail.png'),png);fs.writeFileSync(path.join(out,'grass-detail.json'),JSON.stringify(data,null,2)+'\n');
+  console.log(JSON.stringify({out,pngSHA256:data.pngSHA256,rgbaSHA256:data.rgbaSHA256,sources:Object.keys(sources).length,width:data.width,height:data.height}));
+ }finally{if(browser)await browser.close();await new Promise(resolve=>server.close(resolve));}
+}main().catch(e=>{console.error(e);process.exitCode=1;});
