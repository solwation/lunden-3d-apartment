new file mode 100644
index 00000000..010f68c1
--- /dev/null
+++ b/tools/unreal-engine/python/grass_detail.py
@@ -0,0 +1,98 @@
+"""#2437: source Canvas grass, two source lookups and broad world patches."""
+import hashlib
+import json
+from pathlib import Path
+try:
+    import unreal
+except ModuleNotFoundError:
+    unreal = None
+
+eal = getattr(unreal, "EditorAssetLibrary", None)
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = ROOT / 'tools/unreal-engine/grass-detail'
+TEXTURE = '/Game/Lunden/Materials/Textures/T_LundenGrassDetail'
+TAG = 'Lunden.GrassSourceSHA256'
+
+
+def validate():
+    data = json.loads((SOURCE / 'grass-detail.json').read_text())
+    mandatory = {'src/grass.js', 'src/grassdetail.js', 'src/config.js', 'tools/unreal-engine/export-grass-detail.cjs'}
+    if data.get('version') != 1 or not mandatory <= set(data['sourceFiles']):
+        raise RuntimeError('Grass source manifest missing required identity')
+    for name, digest in data['sourceFiles'].items():
+        file = (ROOT / name).resolve()
+        if not file.is_relative_to(ROOT) or hashlib.sha256(file.read_bytes()).hexdigest() != digest:
+            raise RuntimeError('Grass source changed: ' + name + '; regenerate source Canvas')
+    png = (SOURCE / 'grass-detail.png').read_bytes()
+    if (hashlib.sha256(png).hexdigest() != data['pngSHA256'] or png[:8] != b'\x89PNG\r\n\x1a\n'
+            or [int.from_bytes(png[16:20], 'big'), int.from_bytes(png[20:24], 'big')] != [data['width'], data['height']]
+            or data['threeRevision'] != '170' or data['colorSpace'] != 'srgb' or data['flipY'] is not True
+            or data['width'] != data['config']['textureSize'] or data['height'] != data['width']
+            or data['repeat'] != [1 / data['config']['tile']] * 2 or data['anisotropy'] != 4):
+        raise RuntimeError('Grass source Canvas contract/hash mismatch')
+    return data
+
+
+def fingerprint():
+    validate()
+    return hashlib.sha256((SOURCE / 'grass-detail.json').read_bytes() + Path(__file__).read_bytes()).hexdigest()
+
+
+def settings_ok(asset):
+    return (isinstance(asset, unreal.Texture2D) and asset.get_editor_property('srgb')
+            and asset.get_editor_property('compression_settings') == unreal.TextureCompressionSettings.TC_EDITOR_ICON
+            and asset.get_editor_property('mip_gen_settings') == unreal.TextureMipGenSettings.TMGS_FROM_TEXTURE_GROUP
+            and all(asset.get_editor_property(k) == unreal.TextureAddress.TA_WRAP for k in ('address_x', 'address_y')))
+
+
+def build_texture():
+    digest = fingerprint()
+    asset = eal.load_asset(TEXTURE) if eal.does_asset_exist(TEXTURE) else None
+    if settings_ok(asset) and eal.get_metadata_tag(asset, TAG) == digest:
+        return asset
+    task = unreal.AssetImportTask()
+    task.filename = str(SOURCE / 'grass-detail.png')
+    task.destination_path, task.destination_name = TEXTURE.rsplit('/', 1)
+    task.automated = True
+    task.replace_existing = True
+    task.save = False
+    unreal.AssetToolsHelpers.get_asset_tools().import_asset_tasks([task])
+    asset = eal.load_asset(TEXTURE)
+    if not isinstance(asset, unreal.Texture2D):
+        raise RuntimeError('Grass source texture import failed')
+    asset.set_editor_property('srgb', True)
+    # Uncompressed BGRA8 avoids changing the source texels with block compression.
+    asset.set_editor_property('compression_settings', unreal.TextureCompressionSettings.TC_EDITOR_ICON)
+    asset.set_editor_property('mip_gen_settings', unreal.TextureMipGenSettings.TMGS_FROM_TEXTURE_GROUP)
+    for axis in ('address_x', 'address_y'):
+        asset.set_editor_property(axis, unreal.TextureAddress.TA_WRAP)
+    eal.set_metadata_tag(asset, TAG, digest)
+    if not eal.save_loaded_asset(asset, only_if_is_dirty=False):
+        raise RuntimeError('Could not save ' + TEXTURE)
+    return asset
+
+
+def check_texture():
+    digest = fingerprint()
+    asset = eal.load_asset(TEXTURE) if eal.does_asset_exist(TEXTURE) else None
+    return [] if settings_ok(asset) and eal.get_metadata_tag(asset, TAG) == digest else [TEXTURE + ': missing/stale source Canvas or settings']
+
+
+def source_hlsl():
+    data = validate()
+    g = data['config']
+    code = data['blendGLSL'].replace('#ifdef USE_MAP', '').replace('#endif', '')
+    code = code.replace('vec2', 'float2').replace('vec4', 'float4').replace('mix(', 'lerp(')
+    code = code.replace('texture2D(map, vMapUv)', 'Texture2DSample(GrassDetail, GrassDetailSampler, float2(vMapUv.x, 1.0 - vMapUv.y))')
+    code = code.replace('texture2D(map, grassUvB)', 'Texture2DSample(GrassDetail, GrassDetailSampler, float2(grassUvB.x, 1.0 - grassUvB.y))')
+    code = code.replace('diffuseColor *= sampledDiffuseColor;', 'float3 lin = sampledDiffuseColor.rgb;')
+    if 'texture2D' in code or 'diffuseColor' in code or code.count('Texture2DSample(') != 2:
+        raise RuntimeError('Grass blend source changed; update exact HLSL port')
+    prefix = f'float2 grassMeters = UV;\nfloat2 vMapUv = grassMeters * {data["repeat"][0]:.17g};\n'
+    # Same toFixed(4) constants as grass.js grassMaterial's onBeforeCompile.
+    f = lambda value: f'{value:.4f}'
+    a,b,c = map(f, g['patchFrequencies'])
+    return prefix + code + f'''\nfloat2 p = grassMeters * {f(g['patchScale'])};
+float grassPatch = sin(p.x + sin(p.y * {a})) * sin(p.y * {b} - p.x * {c});
+lin *= 1.0 + grassPatch * {f(g['patchStrength'])};
+lin.b *= 1.0 - (grassPatch * 0.5 + 0.5) * {f(g['patchWarmth'])};\n'''
diff --git a/tools/unreal-engine/tests/leaf-normal.test.mjs b/tools/unreal-engine/tests/leaf-normal.test.mjs
new file mode 100644
index 00000000..e4184696
--- /dev/null
+++ b/tools/unreal-engine/tests/leaf-normal.test.mjs
@@ -0,0 +1,28 @@
+// #2437: source front-normal preservation, not a rendered crown-colour assertion.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+const source = fs.readFileSync('src/foliage.js', 'utf8');
+assert(source.includes("'float faceDirection = 1.0;'"));
+const builder = fs.readFileSync('tools/unreal-engine/python/build_vegetation.py', 'utf8');
+const hlsl = builder.match(/^LEAF_NORMAL_HLSL = "([^"]+)"/m)?.[1];
+assert(hlsl);
+const inputNormal = new Function('FaceSign', 'float3', hlsl);
+assert(builder.includes('m.set_editor_property("tangent_space_normal", spec["normal"]["tangentSpace"])'));
+assert(builder.includes('mel.connect_material_expressions(sign, "", normal, "FaceSign")'));
+assert(builder.includes('mel.connect_material_property(normal, "", u.MaterialProperty.MP_NORMAL)'));
+assert(builder.includes('"normal": {"tangentSpace": True, "hlsl": LEAF_NORMAL_HLSL}'));
+let cases = 0;
+for (const radial of [[0, 0, 1], [1, 0, 0], [0, 1, 0], [.3, .4, .5]]) {
+  const length = Math.hypot(...radial), normal = radial.map(v => v / length);
+  for (const face of [-1, 1]) {
+    const tangent = inputNormal(face, (...v) => v);
+    assert.deepEqual(tangent, [0, 0, face]);
+    // Actual SDK MaterialTemplate.ush4380/4453: WorldNormal *= TwoSidedSign.
+    const final = normal.map(v => v * tangent[2] * face);
+    assert.deepEqual(final, normal);
+    // Negative control: the old default tangent normal flips the back face.
+    if (face < 0) assert(normal.some((v, i) => Math.abs(v - v * face) > .1));
+    cases++;
+  }
+}
+console.log(`LEAF_NORMAL_OK: ${cases} front/back radial cases; old default fails back-face oracle; native compile/capture pending`);
