@@ -219,6 +219,27 @@ def context_function(bp):
     graph.run(bp.generated_class().get_path_name()+':UpdateSky')


+def source_direct_units(sun_lux, sun_clear):
+    """Same unit conversion as build_lighting.LIGHT: SunLux / SunClear, no new calibration."""
+    import math
+    if any(isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) or v <= 0 for v in (sun_lux, sun_clear)):
+        raise ValueError('sourceAmbient: positive finite SunLux/SunClear required')
+    return sun_lux / sun_clear
+
+
+def prepare_fill(bp, components):
+    """Prepare only the opt-in source's real, shadowless DirectionalLight; never save."""
+    import unreal as u
+    fill = components(bp, {'SourceFill': u.DirectionalLightComponent})['SourceFill']
+    fill.set_editor_property('mobility', u.ComponentMobility.MOVABLE)
+    for name in ('atmosphere_sun_light', 'cast_shadows', 'cast_volumetric_shadow',
+                 'cast_shadows_on_clouds', 'cast_shadows_on_atmosphere'):
+        fill.set_editor_property(name, False)
+    fill.set_editor_property('volumetric_scattering_intensity', 0.0)
+    fill.set_editor_property('intensity', 0.0)
+    return fill
+
+
 def sky_parameters(g, e, chain, mpc, contract, constant, connect, *, active=False, direct_units=None):
     """Feed exact source MPC values, independently of old native fill/cube guesses."""
     source.validate(contract)
