+def runtime_spec(root, measurements):
+    """Canonical preparation uses the same hard OFF/coverage guard as material binding."""
+    if not guard(root):
+        return None
+    contract = source.validate(measurements['site']['sourceAmbient'])
+    return {'contract': contract, 'builder': hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
+
+
+def context_function(bp):
+    """Atomic context handoff; callers must supply the actual source room/blind/garage values.
+
+    It does not infer a camera room or replace the player context producer. That
+    real caller binding remains an explicit activation prerequisite.
+    UpdateSky must already exist and is compiled by pp.function before this call.
+    """
+    import player_parts as pp
+    if pp.BP.find_graph(bp, 'SetSourceAmbientContext'):
+        pp.BP.remove_function_graph(bp, 'SetSourceAmbientContext')
+    graph, pins = pp.function(bp, 'SetSourceAmbientContext', inputs=[(name, pp.REAL) for name in CONTEXT_INPUTS])
+    for name in CONTEXT_INPUTS:
+        graph.set(name, pins[name])
+    graph.run(bp.generated_class().get_path_name()+':UpdateSky')
+
+
