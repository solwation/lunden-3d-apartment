<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Lunden</AssemblyName>
    <Version>0.1.0</Version>
    <!-- #2415: what Explorer, Task Manager and Windows security prompts show for Lunden.exe. -->
    <ApplicationIcon>Lunden.ico</ApplicationIcon>
    <Product>Kv. Lunden Unreal L1007</Product>
    <AssemblyTitle>Kv. Lunden Unreal L1007</AssemblyTitle>
    <Company>Svep Design Center AB</Company>
  </PropertyGroup>
  <Target Name="CheckManifestPublicKey" BeforeTargets="PrepareForBuild" Condition="'$(LundenManifestKey)' != ''">
    <PropertyGroup>
      <_PublicKeyFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(LundenManifestKey)'))</_PublicKeyFile>
      <_HasPublicHeader>$([System.IO.File]::ReadAllText('$(_PublicKeyFile)').TrimStart().StartsWith('-----BEGIN PUBLIC KEY-----'))</_HasPublicHeader>
      <_HasPrivateKey>$([System.IO.File]::ReadAllText('$(_PublicKeyFile)').Contains('PRIVATE KEY'))</_HasPrivateKey>
    </PropertyGroup>
    <Error Condition="'$(_HasPublicHeader)' != 'True' Or '$(_HasPrivateKey)' == 'True'"
           Text="LundenManifestKey must contain only the public manifest verification key (SPKI PEM)." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Lunden.Launcher.Tests" />
    <EmbeddedResource Include="Unreal-5.8.4-win64.json" LogicalName="Lunden.Unreal-5.8.4-win64.json" />
    <EmbeddedResource Include="$(LundenManifestKey)" LogicalName="Lunden.ManifestKey.pem" Condition="'$(LundenManifestKey)' != ''" />
    <!-- The publisher's stable Artifact Signing identity, never a short-lived leaf (#2277). -->
    <EmbeddedResource Include="publisher-identity.json" LogicalName="Lunden.PublisherIdentity.json" />
  </ItemGroup>
</Project>
